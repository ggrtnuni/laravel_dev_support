{
    "name": "ggrtnuni/laravel_dev_support",
    "version": "1.0.0",
    "description": "laravel dev support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ggrtnuni"
        }
    ],
    "autoload": {
        "psr-4": {
            "LaravelDevSupport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelDevSupport\\Providers\\LaravelDevSupportServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "phpmyadmin/sql-parser": "^5.11"
    },
    "require-dev": {
        "laravel/framework": "^10.10",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
